# Diese Datei nach .env kopieren und ausfüllen. .env ist in .gitignore.

# --- Supabase (Pflicht) ---------------------------------------------------
# Projekt anlegen unter https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>

# --- Nur für lokale Skripte (nicht ins Frontend, nicht zu Vercel) ---------
# Service-Rolle umgeht RLS. Ausschließlich für den sevDesk-Import.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# sevDesk → Einstellungen → Benutzer → eigener Benutzer → API-Token
SEVDESK_API_TOKEN=<token>
